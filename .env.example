# ============================================================
# QuoteFlow — frontend environment
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser, so
# anything secret must NEVER be put here. The JWT secret and database
# password belong in the backend's own .env (see backend/.env.example).
# ============================================================

# Base URL of the Express API, including the /api prefix.
# The frontend reads this in src/api/client.js.
VITE_API_URL=http://localhost:5000/api
