PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://username:password@localhost:5432/quoteflow

# Signs the auth tokens. Generate your own, do not reuse this value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start with the placeholder below.
JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime: a number of seconds, or a duration like 30m, 12h, 7d.
JWT_EXPIRES_IN=1d

# Optional. Pins "today" for the booking date=upcoming / date=past filters.
# REFERENCE_DATE=2026-09-30
