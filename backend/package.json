{
  "name": "quoteflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "QuoteFlow REST API \u2014 Express + PostgreSQL (Stage 4)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:force": "node src/db/migrate.js --force",
    "seed": "node src/db/seed.js",
    "seed:reset": "node src/db/seed.js --reset",
    "test": "node scripts/api-test.mjs && node scripts/auth-test.mjs",
    "test:api": "node scripts/api-test.mjs",
    "test:auth": "node scripts/auth-test.mjs",
    "test:persistence:create": "node scripts/persistence-test.mjs create",
    "test:persistence:verify": "node scripts/persistence-test.mjs verify"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  }
}
